<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.4" name="Ella">
	<description type="system">
		<author>xenxaarn</author>
		<contact>xenxaarn</contact>
		<specification>Ella OS, an XFCE desktop on Fedora (Tokyo Night theme), built with KIWI NG</specification>
	</description>
	<preferences>
		<version>45</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>UTC</timezone>
		<release-version>45</release-version>
	</preferences>

	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="fedora-cisco-openh264" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-cisco-openh264-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>

	<users>
		<user name="root" groups="root" password="linux" home="/root" pwdformat="plain"/>
	</users>

	<preferences arch="x86_64">
		<type image="iso"
		      publisher="Ella" volid="Ella-Live-45" application_id="Ella-Live-45"
		      primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6"
		      mediacheck="true" firmware="uefi" efiparttable="gpt" efifatimagesize="30"
		      kernelcmdline="quiet rhgb" fscreateoptions="-Efragments -C 1048576"
		      >
			<bootloader name="grub2" grub_template="grub-x86.cfg.iso-template" console="console" timeout="10"/>
		</type>
	</preferences>

	<packages type="bootstrap" patternType="onlyRequired">
		<package name="filesystem"/>
		<package name="grubby"/>
		<package name="dnf5"/>
		<package name="fedora-release-workstation"/>
		<package name="fedora-release-identity-workstation"/>
	</packages>

	<packages type="image" patternType="onlyRequired">
		<!-- XFCE desktop -->
		<package name="xfce4-session"/>
		<package name="xfce4-panel"/>
		<package name="xfce4-settings"/>
		<package name="xfce4-terminal"/>
		<package name="xfdesktop"/>
		<package name="xfwm4"/>
		<package name="xfconf"/>
		<package name="xfce4-appfinder"/>
		<package name="xfce4-power-manager"/>
		<package name="xfce4-notifyd"/>
		<package name="xfce4-screenshooter"/>
		<package name="xfce4-pulseaudio-plugin"/>
		<package name="xfce4-taskmanager"/>
		<package name="xfce4-screensaver"/>
		<package name="mate-polkit"/>
		<package name="dbus-x11"/>
		<package name="plank"/>
		<package name="dconf"/>
		<package name="gtk-update-icon-cache"/>

		<!-- Files, media, utilities -->
		<package name="thunar"/>
		<package name="thunar-volman"/>
		<package name="thunar-archive-plugin"/>
		<package name="tumbler"/>
		<package name="mousepad"/>
		<package name="ristretto"/>
		<package name="file-roller"/>
		<package name="gvfs"/>
		<package name="gvfs-mtp"/>
		<package name="gvfs-smb"/>
		<package name="gvfs-fuse"/>
		<package name="gnome-keyring"/>
		<package name="gnome-keyring-pam"/>
		<package name="celluloid"/>
		<package name="mpv"/>
		<package name="gparted"/>
		<package name="smartmontools"/>
		<package name="gnote"/>
		<package name="firefox"/>
		<package name="mozilla-openh264"/>
		<package name="neovim"/>
		<package name="btop"/>
		<package name="fastfetch"/>

		<!-- Login, display server -->
		<package name="lightdm"/>
		<package name="lightdm-gtk"/>
		<package name="xorg-x11-server-Xorg"/>
		<package name="xorg-x11-drv-libinput"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>

		<!-- Software store, snapshots, menu -->
		<package name="gnome-software"/>
		<package name="PackageKit"/>
		<package name="snapper"/>
		<package name="libdnf5-plugin-actions"/>
		<package name="xdg-user-dirs-gtk"/>
		<package name="xfce4-whiskermenu-plugin"/>

		<!-- System services -->
		<package name="NetworkManager"/>
		<package name="NetworkManager-wifi"/>
		<package name="network-manager-applet"/>
		<package name="bluez"/>
		<package name="blueman"/>
		<package name="power-profiles-daemon"/>
		<package name="firewalld"/>
		<package name="fwupd"/>
		<package name="cups"/>
		<package name="system-config-printer"/>
		<package name="zram-generator-defaults"/>
		<package name="systemd-oomd-defaults"/>
		<package name="systemd-resolved"/>
		<package name="pipewire"/>
		<package name="pipewire-pulseaudio"/>
		<package name="pipewire-alsa"/>
		<package name="wireplumber"/>
		<package name="flatpak"/>
		<package name="distrobox"/>
		<package name="podman"/>
		<package name="fuse-libs"/>
		<package name="xdg-desktop-portal"/>
		<package name="xdg-desktop-portal-gtk"/>
		<package name="xdg-user-dirs"/>
		<package name="xdg-utils"/>

		<!-- Firmware, microcode, hardware support -->
		<package name="linux-firmware"/>
		<package name="amd-ucode-firmware"/>
		<package name="microcode_ctl"/>
		<namedCollection name="hardware-support"/>

		<!-- Fonts -->
		<package name="rsms-inter-fonts"/>
		<package name="jetbrains-mono-fonts-all"/>
		<package name="google-noto-emoji-fonts"/>
		<package name="levien-inconsolata-fonts"/>

		<!-- Boot splash, base system -->
		<package name="plymouth"/>
		<package name="plymouth-system-theme"/>
		<package name="dracut-config-rescue"/>
		<package name="dnf5-plugins"/>
		<package name="sudo"/>
		<package name="bash-completion"/>
		<package name="tar"/>
		<package name="unzip"/>
		<package name="kernel-core"/>
		<ignore name="kernel-*debug*"/>

		<!-- Developer toolchain -->
		<package name="gcc"/>
		<package name="gcc-c++"/>
		<package name="clang"/>
		<package name="clang-tools-extra"/>
		<package name="cmake"/>
		<package name="ninja-build"/>
		<package name="make"/>
		<package name="gdb"/>
		<package name="lldb"/>
		<package name="valgrind"/>
		<package name="pkgconf-pkg-config"/>
		<package name="openssl-devel"/>
		<package name="python3"/>
		<package name="python3-pip"/>
		<package name="python3-devel"/>
		<package name="git"/>
		<package name="curl"/>
		<package name="wget1-wget"/>
	</packages>

	<packages type="iso" patternType="onlyRequired">
		<file name="iso-esp-excludes.yaml" target="image/exclude_files_efifatimage.yaml"/>
		<namedCollection name="anaconda-tools"/>
		<package name="anaconda-install-env-deps"/>
		<package name="anaconda-live"/>
		<package name="aajohan-comfortaa-fonts"/>
		<package name="gum"/>
		<package name="gdisk"/>
		<package name="dosfstools"/>
		<package name="e2fsprogs"/>
		<package name="cryptsetup"/>
		<package name="rsync"/>
		<package name="efibootmgr"/>
		<package name="grub2-tools"/>
		<package name="dracut-live"/>
		<package name="gawk"/>
		<package name="glibc-all-langpacks"/>
		<package name="isomd5sum"/>
		<package name="livesys-scripts"/>
		<package name="btrfs-progs"/>
		<package name="udisks2-btrfs"/>
		<package name="grub2-efi-x64"/>
		<package name="grub2-efi-ia32"/>
		<package name="grub2-efi-x64-modules"/>
		<package name="grub2-efi-ia32-modules"/>
		<package name="grub2-efi-x64-cdboot"/>
		<package name="grub2-efi-ia32-cdboot"/>
		<package name="grub2-pc"/>
		<package name="grub2-pc-modules"/>
		<package name="shim-x64"/>
		<package name="shim-ia32"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<ignore name="device-mapper-multipath"/>
		<ignore name="fcoe-utils"/>
		<ignore name="gfs2-utils"/>
	</packages>
</image>
